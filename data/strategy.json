  "glossary": [
    {
      "term": "RS / Relative Strength",
      "definition": "相对强势：对比指数、板块与同组标的，看谁在下跌时更抗跌、回升时更强；不是这里默认的RSI。"
    },
    {
      "term": "Area of interest",
      "definition": "事前选定的观察区域，如日/周均线、突破位、缺口、前低；到达区域后仍等买方确认。"
    },
    {
      "term": "Pivot",
      "definition": "可作为触发或失效锚点的局部结构高/低；作者常在15/30分钟周期执行。"
    },
    {
      "term": "U&R / Undercut & Reclaim",
      "definition": "先跌破一个关键水平，再收复它；用于弱转强确认。"
    },
    {
      "term": "LOD / HOD",
      "definition": "当日低点/当日高点。LOD是常见多头失效位，HOD可能成为确认或兑现参考。"
    },
    {
      "term": "PLOD / PHOD",
      "definition": "前一个交易日低点/高点；注意不是当前日LOD/HOD。"
    },
    {
      "term": "ORB / ORH",
      "definition": "开盘区间突破/开盘区间高点；作者使用15/30分钟等开盘结构。"
    },
    {
      "term": "VWAP / AVWAP",
      "definition": "成交量加权平均价/从指定锚点起算的成交量加权平均价；在案例中充当收复或支撑阻力参考。"
    },
    {
      "term": "EMA",
      "definition": "指数移动平均线。9/21日EMA是常见兴趣区域，也使用50EMA和周线背景。"
    },
    {
      "term": "Inside day",
      "definition": "当日交易区间包含在前一交易日区间内；作者把关键区域的收缩与后续扩张联系起来。"
    },
    {
      "term": "Pilot / Starter",
      "definition": "试仓：先投入可控暴露验证交易，得到正反馈再考虑增仓。"
    },
    {
      "term": "Cushion / Trim / Runner",
      "definition": "盈利垫/分批减仓/留下继续跟随的仓位。盈利垫不等于未来损失已经不可能。"
    },
    {
      "term": "DTL / EMA crossback",
      "definition": "DTL为下降趋势线；EMA crossback在存档中与重新收复均线和右侧结构同现，但没有完整、统一的机械定义。"
    },
    {
      "term": "RDR / LOD distance",
      "definition": "存档使用RDR与LOD distance标签，但不足以统一其公式。尤其图中LOD dist.%不能擅自当成股票跌幅、账户风险或最大亏损百分比。"
    }
  ],
