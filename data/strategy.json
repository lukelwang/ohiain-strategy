  "principles": [
    {
      "title": "先问环境是否奖励这类风险",
      "body": "检查指数与EMA的关系、创新高/新低、市场宽度、板块轮动、龙头表现和自己最近的交易。健康时逐步增加暴露；连续止损或缺乏跟进时缩小试仓、观察，必要时现金。相对强势在调整期间也可以只记录而不交易。",
      "kind": "明确表达",
